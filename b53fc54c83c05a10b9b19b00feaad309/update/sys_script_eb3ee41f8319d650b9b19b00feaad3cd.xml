        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Access the severity field directly and ensure it's a string
    var severity = current.source_severity.toString();  
    severity = severity.toLowerCase();  // Convert to lowercase

    var riskScore;

    // Determine risk rating and risk score based on severity
    switch (severity) {
        case "critical":
            riskScore = 90;
            break;
        case "high":
            riskScore = 80;
            break;
        case "medium":
            riskScore = 70;
            break;
        case "low":
            riskScore = 50;
            break;
        case "note":
            riskScore = 20;
            break;
        default:
            riskScore = 0;
            break;
    }
    current.risk_score = riskScore;
	
})(current, previous);
]]></script>
