        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    //STATUS MAPPING
    var status_obj = {
        "Open": "Reported",
        "Under Investigation": "Suspicious",
        "Awaiting Implementation": "Confirmed",
        "In Review": "Suspicious",
        "Resolved": "Remediated",
        "Deferred": "Remediated",

        "Closed": "Remediated",
        "Remediated - Auto-Verified": "Remediated",
        "Reported": "Reported"
    };

    var status_val = status_obj[current.state.getDisplayValue()];

    var obj = {
        "traces": [current.source_avit_id.toString()],
        "status": status_val,
        "note": current.work_notes.getJournalEntry(1)
    };
	
    var gr1 = new GlideRecord('x_ntsi_contrast_ap_contrast_vulnerability_status_sync');
    gr1.newRecord();
    gr1.source_record = current.sys_id;
    gr1.payload = JSON.stringify(obj);
    gr1.type = 'IAST';
    gr1.insert();
})(current, previous);]]></script>
